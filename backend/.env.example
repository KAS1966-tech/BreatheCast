# ==============================================================================
# REQUIRED CONFIGURATION (No default values in Python code)
# ==============================================================================

# Your application security key (e.g., a long random hex string)
SECRET_KEY=

GOOGLE_CLIENT_ID= # Your Google OAuth Client ID credentials

# ==============================================================================
# OPTIONAL CONFIGURATION (Defaults are already set in Python code)
# ==============================================================================

# ------------------------
# Database Config
# ------------------------
DATABASE_USER=postgres
DATABASE_PASSWORD= # your strong password
DATABASE_DB=breathecast
DATABASE_PORT=5432
DATABASE_HOST=db # or localhost if you are running the database on your local machine

# ------------------------
# Security Expirations
# ------------------------
ACCESS_TOKEN_EXPIRY_MINUTES=30
REFRESH_TOKEN_EXPIRY_DAYS=7

# ------------------------
# Environment
# ------------------------
DEBUG=False
ENVIRONMENT=development

# ------------------------
# CORS (Comma-separated if overridden)
# ------------------------
ALLOWED_ORIGINS=

# BREVO API KEY 
BREVO_API_KEY=
BREVO_SENDER_EMAIL=someone@gmail.com